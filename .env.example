NEXT_PUBLIC_SITE_URL=https://infoquest-cahul.vercel.app
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose these values with a NEXT_PUBLIC_ prefix.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1

# OpenAI model IDs, без префикса openai/
AI_ANALYSIS_MODEL=gpt-5-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_REASONING_EFFORT=
AI_REQUEST_TIMEOUT_MS=45000

# Optional ElevenLabs Text-to-Speech for Chrono AI (falls back to browser speechSynthesis if unset).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Server-only random secret used to create non-reversible IP block fingerprints.
# Set in Vercel Production and Preview; environments sharing blocklists need the same salt.
# Generate once and do not rotate it unless IP blocks are reset.
BLOCKLIST_IP_SALT=
