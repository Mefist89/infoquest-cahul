NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose these values with a NEXT_PUBLIC_ prefix.
AI_API_KEY=
AI_API_BASE_URL=https://openai.bothub.chat/v1

# OpenAI-compatible model IDs configured in the BotHub account.
AI_ANALYSIS_MODEL=openai/gpt-5.5
AI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
AI_REQUEST_TIMEOUT_MS=45000

# Server-only random secret used to create non-reversible IP block fingerprints.
# Generate once for each environment and do not rotate it unless IP blocks are reset.
BLOCKLIST_IP_SALT=
